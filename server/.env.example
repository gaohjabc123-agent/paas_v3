# ============================================================
# 如影 AI 能力开放平台 — 服务端配置示例
# 复制为项目根目录 .env（与 package.json 同级）；密钥只在服务端，永不进入前端
# ============================================================

# 单端口服务（静态前端 + 同源 API）
PORT=8080

# 运行模式：true=演示环境（本地模拟，零费用、无需密钥，默认）
#           false=真实环境（调用如影 PaaS 线上 API，按量计费）
RUYING_MOCK=true

# ---- 以下仅真实模式需要（在如影 PaaS 控制台「账户信息」中获取）----
RUYING_APP_ID=
RUYING_APP_KEY=
RUYING_BASE_URL=https://aigc.softsugar.com

# 签名时间戳单位：ms（13 位毫秒，默认）或 s（10 位秒）
SIGN_TS_UNIT=ms

# 计费接口保护：false=拒绝调用计费接口（默认，演示/培训务必保持），true=放行
# 开启后 /api/avatar、/api/video 等才会真正提交到平台并产生费用
ALLOW_BILLABLE=false

# ---- 演示模式调参（可选）----
MOCK_TASK_MS=1400
MOCK_SSE_DELAY_MS=15
